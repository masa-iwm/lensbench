{
 "$schema": "https://masa-iwm.github.io/lensbench/schema/v0.12/project.schema.json",
 "name": "P20 Mach-Zehnder: BS2 placed in global coordinates, the reflected arm joins it at port D",
 "glass_catalogs": ["SCHOTT"],
