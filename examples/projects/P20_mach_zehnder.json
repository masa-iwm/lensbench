   ],
   "r": [
    {"type": "air", "t": 50},
    {"type": "mirror", "id": "M2", "tilt": [-45, 0], "semi": 15},
    {"type": "air", "t": 50},
    {"type": "join", "splitter": "BS2", "port": "d"}
   ],
   "d": [{"type": "air", "t": 20}]}
 ],
 "beams": [
