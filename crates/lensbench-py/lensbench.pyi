    frame is "object" (the object coordinate system, as trace_rays) or "global".
    Returned dict: start and direction ((rays, 3); directions as the source gave them) and weight ((rays,)).
    Pass start and direction to `system.trace_rays(start, direction, waves=[wave], frame=frame)`
    """


def swap_search(project: _StrPath, spec: Any, glass_dirs: Sequence[_StrPath] | None = None, lens_catalogs: Sequence[_StrPath] | None = None, top: int = 0, threads: int | None = None, out: _StrPath | None = None, resume: bool = True) -> Any:
    """Catalog lens swap search: runs in parallel the sets with the lens blocks of project (path of a project file) swapped for the candidates of spec (a dict or JSON
    string; the same as the CLI's swap --spec: slots, vars, merit, iters, efl, state and so on) and
    optimizes the variables of each set. Returns a list of result dicts per set (smallest merit first; the first top if top > 0).
    Each dict is the same as the results of the CLI's swap --json (i, lenses, merit0, merit, image_merit, vars, efl, stop,
    iterations, total_track; error if it can't be evaluated). With out (JSONL) each set is written as it finishes; with resume
    it continues from the file of the same search (the batch form)
    """


def trace_many(systems: Sequence[System], field: _Field | None, px: ArrayLike, py: ArrayLike, waves: Sequence[int] | None = None, last: int | None = None, record: bool | Sequence[int] = ..., pol: bool | int | None = None, pol_phase: bool = False, globals: bool = False, object: _ObjectPoint | None = None, grad: Sequence[str] | None = None, threads: int | None = None, pupil: str = "normalized", dz: float | ArrayLike | None = None, land: bool = False) -> list[_TraceResult]:
    """Trace many systems together in one call. Returns a list of dicts, one per system,
    each bit for bit the same as `systems[i].trace(field, px, py, ...)` (for any number of threads).

    The arguments are as in System.trace, the same for all systems (grad parameter names are resolved per system).
    Parallel over both systems and rays, so all cores are used even with few rays per system.
    threads is the total number of threads (1 for sequential)
    """


