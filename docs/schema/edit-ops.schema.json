        "rod_spacing": {
          "default": 0.0,
          "description": "ケージのロッドの間隔 [mm]（0 はケージ板でない）",
          "format": "double",
          "type": "number"
        },
        "square": {
          "description": "外形が角（`outer_radius` は正方形の一辺の半分、辺は部品の x・y 軸に沿う）。false は丸",
          "type": "boolean"
        },
        "step": {
          "description": "部品の詳しい形の STEP（品の公式の STEP を取ったキャッシュのファイル）。描画で詳しい形を選ぶと使う",
          "type": "string"
        },
        "step_flip": {
          "description": "STEP の形を裏返して置く（部品を `reversed` で置いた。z → 長さ − z、y → −y）",
          "type": "boolean"
        },
        "surface": {
          "description": "置く基準の面（その面の局所座標）",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "tilt": {
          "default": [
            0.0,
            0.0
          ],
          "description": "傾き [tx, ty] [deg]（ずらした後、x → y の順）",
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        }
      },
      "required": [
        "name",
        "surface",
        "bores"
      ],
      "type": "object"
    },
    "Num": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "additionalProperties": false,
          "properties": {
            "$f": {
              "enum": [
                "inf",
                "-inf",
                "nan"
              ]
            }
          },
          "required": [
            "$f"
          ],
          "type": "object"
        }
      ],
      "description": "数。JSON に書けない数は {\"$f\": \"inf\"}（-inf・nan も）"
    },
    "Ref": {
      "anyOf": [
        {
          "description": "番号",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        {
          "description": "名前",
          "type": "string"
        }
      ],
      "description": "番号か名前。面は OpticStudio の面番号か面のコメント、玉・群と機構部品は 0 始まりの番号か名前"
    },
    "SolveWhat": {
      "description": "ソルブを外す量",
      "oneOf": [
        {
          "const": "t",
          "description": "厚さ（既定）",
          "type": "string"
        },
        {
          "const": "c",
          "description": "曲率",
          "type": "string"
        }
      ]
    }
  },
  "$id": "https://masa-iwm.github.io/lensbench/schema/v0.12/edit-ops.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "items": {
    "$ref": "#/$defs/EditOp"
  },
  "title": "lensbench 系の編集の操作の列（serve の edit の ops）",
  "type": "array"
}
