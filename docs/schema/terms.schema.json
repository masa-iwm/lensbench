      "description": "calc の引数"
    },
    "CalcName": {
      "description": "calc の演算（OpticStudio の SUMM・OSUM は sum、DIFF は diff、PROD は prod、DIVI は div、ABSO は abs、SQRT は sqrt（√|a|）、RECI は reci）",
      "enum": [
        "sum",
        "diff",
        "prod",
        "div",
        "abs",
        "sqrt",
        "reci"
      ],
      "type": "string"
    },
    "DirName": {
      "description": "MTF の向き",
